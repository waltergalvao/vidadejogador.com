    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/swc-plugin": "^6.7.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
